# MongoDB Atlas connection string (free tier is fine to start)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dora-cms

# Random secret used to sign admin session tokens — generate with:
#   openssl rand -hex 32
JWT_SECRET=

# Bcrypt hash of the client's admin password — generate with:
#   npm run hash-password -- "the-actual-password"
# Never put the plain password itself in this file.
DORA_ADMIN_PASSWORD_HASH=

# Comma-separated list of origins allowed to call this API
ALLOWED_ORIGINS=https://yoursite.com,http://localhost:3000

# Used only when running as a standalone Node process (Render). Ignored on Vercel.
PORT=4000

# Where uploaded images go. Defaults to "s3" — leave unset unless you want
# one of the alternatives below. Only the vars for your chosen driver are
# required; the rest can stay blank.
# STORAGE_DRIVER=s3

# --- s3 (default): S3-compatible object storage (AWS S3, Cloudflare R2, Backblaze B2, ...)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only needed for non-AWS providers, e.g. Cloudflare R2:
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Public base URL uploads are served from (your bucket's public URL or a CDN in front of it)
S3_PUBLIC_URL_BASE=

# --- cloudinary: set STORAGE_DRIVER=cloudinary and fill these in instead of the S3_* vars above
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- vercel-blob: set STORAGE_DRIVER=vercel-blob and fill this in instead
# (only useful when this backend is itself deployed on Vercel)
# BLOB_READ_WRITE_TOKEN=

# --- local: set STORAGE_DRIVER=local for zero-cloud-accounts local dev, or
# on a persistent-disk host like Render. Does NOT work on Vercel (serverless
# functions have no persistent filesystem) or across more than one instance.
# LOCAL_UPLOAD_DIR=uploads
# LOCAL_UPLOAD_PUBLIC_URL_BASE=/uploads

# Optional. Rate limiting defaults to counting requests per-process, which is
# correct for a single server instance. If you scale this backend to more
# than one instance, set this to a Redis connection string so rate limits
# are enforced correctly across all of them instead of per-instance.
# REDIS_URL=redis://default:<password>@<host>:6379
